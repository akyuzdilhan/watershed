{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "webImage": { "value": "${SERVICE_WEB_IMAGE_NAME=}" },
    "workerImage": { "value": "${SERVICE_WORKER_IMAGE_NAME=}" },
    "foundryAccountId": { "value": "${FOUNDRY_ACCOUNT_ID=}" },
    "foundryProjectEndpoint": { "value": "${FOUNDRY_PROJECT_ENDPOINT=}" },
    "foundryModel": { "value": "${FOUNDRY_MODEL=gpt-5.4-nano}" },
    "foundryReasoningEffort": { "value": "${FOUNDRY_REASONING_EFFORT=medium}" },
    "foundryMaxTokens": { "value": "${FOUNDRY_MAX_TOKENS=5000}" },
    "foundryRecapReasoningEffort": { "value": "${FOUNDRY_RECAP_REASONING_EFFORT=low}" },
    "foundryRecapMaxTokens": { "value": "${FOUNDRY_RECAP_MAX_TOKENS=6000}" },
    "workerExtraArgs": { "value": "${WORKER_EXTRA_ARGS=}" },
    "workerMinReplicas": { "value": "${WORKER_MIN_REPLICAS=0}" },
    "webAuthClientId": { "value": "${WEB_AUTH_CLIENT_ID=}" },
    "webProducers": { "value": "${PRODUCERS=}" },
    "webMinReplicas": { "value": "${WEB_MIN_REPLICAS=0}" },
    "webRateLimitPerMin": { "value": "${RATE_LIMIT_PER_MIN=600}" }
  }
}
