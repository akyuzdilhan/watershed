# Foundry project endpoint (Foundry portal > project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Model deployment name (no fallback model: the templates write when the model fails)
FOUNDRY_MODEL=gpt-5.4-nano
# Reasoning effort (medium: see the model benchmark)
FOUNDRY_REASONING_EFFORT=medium
# Service Bus and Cosmos DB (outputs of azd provision: azd env get-values)
SERVICE_BUS_FQDN=sb-<suffix>.servicebus.windows.net
SERVICE_BUS_TOPIC=match-events
COSMOS_ENDPOINT=https://cosmos-<suffix>.documents.azure.com:443/
COSMOS_DATABASE=watershed
