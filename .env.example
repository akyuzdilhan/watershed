# Foundry project endpoint (Foundry portal > project > Overview)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Main model deployment name
FOUNDRY_MODEL=gpt-5.4-nano
# Fallback model deployment name
FOUNDRY_MODEL_FALLBACK=gpt-5-mini
# Reasoning effort (medium: see the model benchmark)
FOUNDRY_REASONING_EFFORT=medium
